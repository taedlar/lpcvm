// Example LPC source file for testing the parser

#define ARMOR "/path/to/armor"

inherit "/std/player" as base;

mount "efun://console";
void write(string s) {} // TODO: acquired via efun://console mounted resource

int g = 123;
string *words = ({ "a", "b", "c" }); // aggregate array
mapping dict = ([ "key1": "value1", "key2": "value2" ]); // aggregate mapping (associative array)

#define ADD(first, second) ((first) + (second))


int add (int x, int y, string, ... argv) {
    mount "/daemon/weather.lpc" as WEATHER_D; // mount a LPC blueprint in filesystem
    mount "/area/village/weapon" as Weapon; // mount a filesystem directory
    int a = argv[3], b = y - g;
    object obj = self;
    object sword = new Weapon::broadsword{damage=10};

    base.set_max_hp (100); // call a method on the inherited base object
    using (WEATHER_D) { // implicitly load the WEATHER_D resource if not already loaded
        ::show_weather(); // call a method on the mounted WEATHER_D resource
    }

    using (sword) { // acquires strong reference to the object, preventing premature destruction
        ->set_name("steel broadsword"); // call a method on the sword object
        ->set_damage(10);
        base.equip(sword);
    }

    // exception handling example
    try {
        int e = 100 / 0;
    } catch (mapping e) {
        write (text="Caught exception: " + e["msg"]);
    }
    return ADD(a, b); // macro expansion
}
